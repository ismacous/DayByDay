<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Aucune permission INTERNET : l'application ne peut techniquement pas
         envoyer tes donnees sur un reseau. Tout reste dans le stockage prive
         de l'app sur le telephone.

         La ligne ci-dessous n'ajoute rien : elle **retire** la permission si
         une bibliotheque la reclame dans son propre manifeste. Sans elle, la
         garantie ne tiendrait qu'a la vigilance ; avec elle, c'est la
         compilation qui la fait respecter, meme le jour ou une dependance
         ajoutee sans y penser voudrait acceder au reseau. -->
    <uses-permission
        android:name="android.permission.INTERNET"
        tools:node="remove" />

    <!-- Uniquement pour le rappel quotidien local. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Les vocaux du journal. Le fichier est ecrit dans le dossier prive de
         l'application, comme les photos : sans permission Internet, il ne peut
         aller nulle part ailleurs. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Le rappel du soir est une **alarme a heure fixe**, pas une tache de
         fond : une tache periodique n'a pas d'heure, elle a une periode, et
         Android la place ou ca l'arrange. Ces deux permissions ne donnent
         acces a rien : elles autorisent seulement a viser une heure precise.
         `USE_EXACT_ALARM` couvre Android 13 et plus sans rien demander a
         l'utilisateur ; `SCHEDULE_EXACT_ALARM` sert aux versions d'avant. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />

    <!-- Un redemarrage efface les alarmes : sans ca, le rappel disparaitrait
         silencieusement au premier reboot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Lecture locale des pas (via Health Connect) et du temps d'ecran.
         Les deux restent sur le telephone : aucune sortie reseau possible. -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <application
        android:name=".DayByDayApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="false"
        android:theme="@style/Theme.DayByDay">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.DayByDay">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Ecran d'explication demande par Health Connect. -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:targetActivity=".ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!-- Recoit les alarmes, et les rearme : au reveil du telephone, apres
             une mise a jour, et quand l'heure du systeme change. Non exporte :
             les alarmes viennent d'un intent explicite vers cette classe, et
             les trois autres actions sont des diffusions protegees que seul le
             systeme peut envoyer. -->
        <receiver
            android:name=".work.ReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
